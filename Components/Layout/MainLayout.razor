@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar" aria-label="Primary navigation">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row px-4">
            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="user-label">Signed in as <strong>@auth.User.Identity?.Name</strong></span>
                    <form method="post" action="/auth/logout" data-enhance="false">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login">Sign in</a>
                    <a class="btn btn-sm btn-primary ms-2" href="register">Create account</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. Reload the page and try again.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>
