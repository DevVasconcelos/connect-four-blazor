@page "/matches"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GameRecordStore MatchStore
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Match History | Connect Four</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">YOUR DATA</p>
        <h1>Match history</h1>
        <p class="text-secondary">Review, edit, and delete the results saved to your account.</p>
    </div>
    <a class="btn btn-primary" href="matches/new">Add match</a>
</div>

@if (_loading)
{
    <div class="page-card" role="status">Loading match history...</div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else
{
    <section class="stats-grid" aria-label="Match statistics">
        <div class="stat-card">
            <span class="stat-label">Matches</span>
            <strong>@_records.Count</strong>
        </div>
        <div class="stat-card">
            <span class="stat-label">Decisive games</span>
            <strong>@_records.Count(record => !record.Outcome.Equals("Draw", StringComparison.OrdinalIgnoreCase))</strong>
        </div>
        <div class="stat-card">
            <span class="stat-label">Draws</span>
            <strong>@_records.Count(record => record.Outcome.Equals("Draw", StringComparison.OrdinalIgnoreCase))</strong>
        </div>
    </section>

    <section class="page-card">
        @if (_records.Count == 0)
        {
            <div class="empty-state">
                <h2>No saved matches yet</h2>
                <p>Play a game and save the result, or add a match manually.</p>
                <a class="btn btn-primary" href="/">Play now</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle match-table">
                    <caption class="visually-hidden">Your saved Connect Four matches</caption>
                    <thead>
                        <tr>
                            <th scope="col">Players</th>
                            <th scope="col">Outcome</th>
                            <th scope="col">Moves</th>
                            <th scope="col">Played</th>
                            <th scope="col">Notes</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in _records)
                        {
                            <tr>
                                <td><strong>@record.PlayerOneName</strong> vs. <strong>@record.PlayerTwoName</strong></td>
                                <td>@record.Outcome</td>
                                <td>@record.MoveCount</td>
                                <td>@record.PlayedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                <td>@(string.IsNullOrWhiteSpace(record.Notes) ? "—" : record.Notes)</td>
                                <td class="text-nowrap text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="matches/@record.Id/edit">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger ms-1"
                                            @onclick="() => DeleteAsync(record.Id)"
                                            disabled="@_deleting"
                                            aria-label="Delete match between @record.PlayerOneName and @record.PlayerTwoName">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private List<GameRecord> _records = [];
    private Guid _userId;
    private bool _loading = true;
    private bool _deleting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!Guid.TryParse(userIdValue, out _userId))
            {
                _errorMessage = "Your session could not be identified. Please sign in again.";
                return;
            }

            _records = (await MatchStore.GetForUserAsync(_userId)).ToList();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(Guid recordId)
    {
        if (_deleting || _userId == Guid.Empty)
        {
            return;
        }

        _deleting = true;
        _errorMessage = null;

        try
        {
            await MatchStore.DeleteAsync(_userId, recordId);
            _records.RemoveAll(record => record.Id == recordId);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }
}
