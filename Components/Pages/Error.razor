@page "/Error"
@using System.Diagnostics
@attribute [AllowAnonymous]

<PageTitle>Error | Connect Four</PageTitle>

<section class="page-card narrow-card">
    <p class="eyebrow">ERROR</p>
    <h1>We couldn't complete that request.</h1>
    <p>Reload the page and try again. If the problem continues, return to the game and start again.</p>

    @if (ShowRequestId)
    {
        <p class="text-secondary small">Request ID: <code>@RequestId</code></p>
    }

    <a class="btn btn-primary" href="/">Return to game</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrWhiteSpace(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
