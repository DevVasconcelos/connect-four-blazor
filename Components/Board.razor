@rendermode InteractiveServer

<div class="game-container">
    <div class="game-header">
        <h3>@StatusMessage</h3>
        <button class="new-game-button" @onclick="NewGame">
            New Game
        </button>
    </div>

    <div class="column-buttons">
        @for (var col = 0; col < Columns; col++)
        {
            var column = col;

            <button @onclick="() => DropPiece(column)"
                    disabled="@(_gameOver || _board[0, column] != 0)"
                    aria-label="Drop piece in column @(column + 1)">
                ↓
            </button>
        }
    </div>

    <div class="game-board">
        @for (var row = 0; row < Rows; row++)
        {
            @for (var col = 0; col < Columns; col++)
            {
                var cell = _board[row, col];

                <div class="slot @GetCellClass(cell)"></div>
            }
        }
    </div>

    <div class="move-history">
        <h4>Move History</h4>

        @if (_moves.Count == 0)
        {
            <p>No moves yet.</p>
        }
        else
        {
            <ol>
                @foreach (var move in _moves)
                {
                    <li>@move</li>
                }
            </ol>
        }
    </div>
</div>

@code {
    private const int Rows = 6;
    private const int Columns = 7;

    private int[,] _board = new int[Rows, Columns];

    private int _currentPlayer = 1;
    private int _winner;
    private bool _gameOver;

    private readonly List<string> _moves = new();

    private string StatusMessage =>
        _winner != 0
            ? $"Player {_winner} wins!"
            : _gameOver
                ? "Draw!"
                : $"Player {_currentPlayer}'s turn";

    private void DropPiece(int column)
    {
        if (_gameOver)
            return;

        for (var row = Rows - 1; row >= 0; row--)
        {
            if (_board[row, column] != 0)
                continue;

            _board[row, column] = _currentPlayer;

            _moves.Add(
                $"Player {_currentPlayer} - Column {column + 1}"
            );

            if (CheckWin(row, column))
            {
                _winner = _currentPlayer;
                _gameOver = true;
                return;
            }

            if (BoardIsFull())
            {
                _gameOver = true;
                return;
            }

            _currentPlayer = _currentPlayer == 1 ? 2 : 1;
            return;
        }
    }

    private bool CheckWin(int row, int column)
    {
        return CountConnected(row, column, 0, 1) >= 4 ||
               CountConnected(row, column, 1, 0) >= 4 ||
               CountConnected(row, column, 1, 1) >= 4 ||
               CountConnected(row, column, 1, -1) >= 4;
    }

    private int CountConnected(
        int row,
        int column,
        int rowDirection,
        int columnDirection)
    {
        var player = _board[row, column];

        return 1
            + CountDirection(
                row,
                column,
                rowDirection,
                columnDirection,
                player)
            + CountDirection(
                row,
                column,
                -rowDirection,
                -columnDirection,
                player);
    }

    private int CountDirection(
        int row,
        int column,
        int rowDirection,
        int columnDirection,
        int player)
    {
        var count = 0;

        row += rowDirection;
        column += columnDirection;

        while (
            row >= 0 &&
            row < Rows &&
            column >= 0 &&
            column < Columns &&
            _board[row, column] == player)
        {
            count++;

            row += rowDirection;
            column += columnDirection;
        }

        return count;
    }

    private bool BoardIsFull()
    {
        for (var column = 0; column < Columns; column++)
        {
            if (_board[0, column] == 0)
                return false;
        }

        return true;
    }

    private string GetCellClass(int cell)
    {
        return cell switch
        {
            1 => "player-one",
            2 => "player-two",
            _ => string.Empty
        };
    }

    private void NewGame()
    {
        _board = new int[Rows, Columns];

        _currentPlayer = 1;
        _winner = 0;
        _gameOver = false;

        _moves.Clear();
    }
}

<style>
    .game-container {
        width: fit-content;
        margin-top: 20px;
    }

    .game-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 12px;
    }

    .game-header h3 {
        margin: 0;
    }

    .new-game-button {
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        background-color: #212529;
        color: white;
        cursor: pointer;
    }

    .column-buttons {
        display: grid;
        grid-template-columns: repeat(7, 60px);
        gap: 6px;
        padding: 0 12px;
        margin-bottom: 6px;
    }

    .column-buttons button {
        width: 60px;
        height: 36px;
        border: none;
        border-radius: 6px;
        background-color: #0d6efd;
        color: white;
        font-size: 20px;
        cursor: pointer;
    }

    .column-buttons button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .game-board {
        display: grid;
        grid-template-columns: repeat(7, 60px);
        gap: 6px;
        width: fit-content;
        padding: 12px;
        background-color: #f4c430;
        border-radius: 12px;
    }

    .slot {
        width: 60px;
        height: 60px;
        background-color: white;
        border-radius: 50%;
    }

    .slot.player-one {
        background-color: #dc3545;
    }

    .slot.player-two {
        background-color: #0d6efd;
    }

    .move-history {
        margin-top: 20px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        max-height: 220px;
        overflow-y: auto;
    }

    .move-history h4 {
        margin-top: 0;
    }

    .move-history ol {
        margin-bottom: 0;
        padding-left: 25px;
    }
</style>